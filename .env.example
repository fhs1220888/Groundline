# Copy to .env and fill in:   cp .env.example .env
# .env is git-ignored — never commit your API key.

# Which agent the CLI uses by default: rule | openai | anthropic
GROUNDLINE_AGENT=openai

# OpenAI
OPENAI_API_KEY=sk-your-key-here
GROUNDLINE_LLM_MODEL=gpt-5.6-sol
# reasoning models: none | low | medium (default) | high — lower is cheaper/faster
# GROUNDLINE_LLM_REASONING_EFFORT=low

# Any other OpenAI-compatible endpoint (Qwen/DashScope, DeepSeek, vLLM, Ollama ...):
# GROUNDLINE_LLM_BASE_URL=http://localhost:11434/v1
# GROUNDLINE_LLM_API_KEY=
# GROUNDLINE_LLM_MODEL=qwen2.5:32b

# Anthropic
# GROUNDLINE_AGENT=anthropic
# ANTHROPIC_API_KEY=
# GROUNDLINE_LLM_MODEL=claude-sonnet-5

# Optional
# GROUNDLINE_LLM_TEMPERATURE=0
GROUNDLINE_LANG=zh
